# ====================================
# Schoolnify Monorepo .gitignore
# ====================================

# ====================================
# Python / FastAPI Backend
# ====================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.env.local

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Ruff
.ruff_cache/

# ====================================
# Node.js / Next.js Frontend
# ====================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Next.js
.next/
out/

# Build outputs
build/
dist/

# Testing
coverage/
.nyc_output/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ====================================
# Environment Variables
# ====================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ====================================
# IDE / Editor
# ====================================

